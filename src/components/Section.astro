---
interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<section class="reveal">
	{
		title && (
			<h2>
				<span class="dot" />
				{title}
			</h2>
		)
	}
	<slot />
</section>

<style>
	section {
		max-width: var(--maxw);
		margin: 0 auto 3.5rem;
	}
	h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.25rem;
		font-weight: 700;
		font-size: 1.35rem;
		color: var(--text);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-grad);
		box-shadow: 0 0 12px var(--glow);
		flex-shrink: 0;
	}

	/* Ningún título de sección queda huérfano al final de una hoja: si no
	   entra junto con lo que le sigue, ambos pasan enteros a la siguiente. */
	@media print {
		h2 {
			break-after: avoid;
			page-break-after: avoid;
		}
	}
</style>
