---
import Section from "@/components/Section.astro";
import { projects } from "@cv";
import GitHub from "@/icons/GitHub.astro";
---

<Section title="Proyectos">
	<ul class="grid">
		{
			projects.map(
				({ url, description, highlights, name, isActive, github, process_url }) => {
					return (
						<li>
							<article>
								<header>
									<h3>
										<a
											href={url}
											target="_blank"
											rel="noopener noreferrer"
											title={`Ver el proyecto ${name}`}
										>
											{name}
										</a>
										{isActive && (
											<span class="active" title="Activo / en curso" />
										)}
									</h3>
									<p>{description}</p>
								</header>

								{highlights && highlights.length > 0 && (
									<ul class="tags">
										{highlights.map((h) => (
											<li>{h}</li>
										))}
									</ul>
								)}

								<footer>
									{process_url && (
										<a
											class="link"
											href={process_url}
											target="_blank"
											rel="noopener noreferrer"
										>
											Ver proceso →
										</a>
									)}
									{github && (
										<a
											class="link icon"
											href={github}
											target="_blank"
											rel="noopener noreferrer"
											title={`Código de ${name}`}
										>
											<GitHub />
											Código
										</a>
									)}
								</footer>
							</article>
						</li>
					);
				},
			)
		}
	</ul>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}
	article {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		border: 1px solid var(--border);
		background: var(--surface);
		border-radius: var(--radius);
		padding: 1.2rem;
		transition:
			border-color 0.25s ease,
			transform 0.25s ease,
			background 0.25s ease,
			box-shadow 0.25s ease;
	}
	article:hover {
		border-color: var(--border-strong);
		background: var(--surface-2);
		transform: translateY(-4px);
		box-shadow: var(--shadow);
	}
	header {
		flex: 1;
	}
	h3 {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 0.4rem;
	}
	h3 a {
		color: var(--text);
		transition: color 0.2s ease;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.active {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-grad);
		box-shadow: 0 0 10px var(--glow);
		flex-shrink: 0;
	}
	p {
		font-size: 0.85rem;
		line-height: 1.55;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.tags li {
		font-size: 0.68rem;
		font-weight: 500;
		color: var(--text-muted);
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface-2);
	}
	footer {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.4rem;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		transition: opacity 0.2s ease;
	}
	.link:hover {
		opacity: 0.75;
	}
	.link.icon {
		color: var(--text-muted);
	}
</style>
